{
	"name": "hlidskjalf",
	"version": "0.4.4",
	"description": "A Terminal User Interface for monitoring Turborepo tasks, built with Ink",
	"type": "module",
	"author": "Charlie Beckstrand",
	"license": "MIT",
	"keywords": [
		"turborepo",
		"monorepo",
		"terminal",
		"tui",
		"dev",
		"pnpm"
	],
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"hlidskjalf": "dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"bench": "tsx __benchmarks__/index.ts"
	},
	"dependencies": {
		"ink": "^5.2.1",
		"react": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.20.4",
		"@types/react": "^18.3.31",
		"@vitest/coverage-v8": "^5.0.2",
		"ink-testing-library": "^4.0.0",
		"lefthook": "^2.1.14",
		"tinybench": "^6.2.0",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	}
}
