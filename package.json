{
	"name": "hlidskjalf",
	"version": "0.4.5",
	"description": "A Terminal User Interface for monitoring Turborepo tasks, built with Ink",
	"type": "module",
	"author": "Charlie Beckstrand",
	"license": "MIT",
	"keywords": [
		"turborepo",
		"monorepo",
		"terminal",
		"tui",
		"dev",
		"pnpm"
	],
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=22.18"
	},
	"bin": {
		"hlidskjalf": "dist/index.js"
	},
	"main": "./dist/config.js",
	"types": "./dist/config.d.ts",
	"exports": {
		".": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"bench": "tsx __benchmarks__/index.ts"
	},
	"dependencies": {
		"ink": "^8.0.0",
		"react": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"ink-testing-library": "^4.0.0",
		"lefthook": "^2.2.2",
		"tinybench": "^6.2.3",
		"tsdown": "^0.23.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
